PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/innovote

# Session JWT (voter cookie: innovote_session)
JWT_SECRET=change-me-to-a-long-random-string

# Client origin allowed for CORS (credentialed requests)
CLIENT_ORIGIN=http://localhost:5173

# Admin login (admin cookie: innovote_admin_session)
ADMIN_USERNAME=admin
# bcrypt hash of the admin password — generate with: node -e "require('bcrypt').hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# Cloudinary — used to host project/research paper images uploaded from the admin panel
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
